{
    "type": "module",
    "scripts": {
        "dev": "vite",
        "test": "npx vitest run",
        "test:watch": "npx vitest",
        "test:coverage": "npx vitest run --coverage",
        "test:e2e": "playwright test",
        "test:visual": "playwright test --project=visual-chromium --project=visual-firefox",
        "test:visual:update": "UPDATE_BASELINE=1 playwright test --project=visual-chromium --project=visual-firefox",
        "lint": "eslint \"js/**/*.{js,ts}\"",
        "lint:fix": "eslint \"js/**/*.{js,ts}\" --fix",
        "typecheck": "tsc --noEmit",
        "build": "vite build"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.11.3",
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.61.0",
        "@types/node": "^25.9.3",
        "@types/pngjs": "^6.0.5",
        "@types/three": "^0.184.0",
        "@vitest/coverage-istanbul": "^4.1.9",
        "@vitest/coverage-v8": "^4.1.9",
        "c8": "^11.0.0",
        "clean-css-cli": "^5.6.3",
        "eslint": "^10.6.0",
        "globals": "^17.6.0",
        "http-server": "^14.1.1",
        "jsdom": "^29.1.1",
        "pixelmatch": "^7.2.0",
        "pngjs": "^7.0.0",
        "terser": "^5.48.0",
        "typescript": "^6.0.3",
        "vite": "^8.0.16",
        "vite-plugin-pwa": "^1.3.0",
        "vitest": "^4.1.9",
        "workbox-window": "^7.4.0"
    },
    "c8": {
        "all": true,
        "include": [
            "js/**/*.{js,ts}"
        ],
        "exclude": [
            "js/three.min.js",
            "js/main.js",
            "js/card.ts",
            "js/errorHandler.ts",
            "js/performanceMonitor.ts",
            "js/workers/aiWorker.js",
            "js/icons.ts",
            "js/event-bus-types.ts",
            "js/3d/Game3D.ts",
            "js/hexgrid.ts",
            "js/ui.ts",
            "js/ui/**",
            "js/game/HeroController.ts",
            "js/game/InputController.ts",
            "js/siteInteraction.ts",
            "js/particles.ts",
            "js/touchController.ts",
            "tests/**",
            "node_modules/**",
            "*.config.js"
        ],
        "reporter": [
            "text",
            "html",
            "lcov"
        ],
        "report-dir": "./coverage",
        "clean": true,
        "check-coverage": true,
        "lines": 80,
        "functions": 80,
        "branches": 80,
        "statements": 80
    },
    "dependencies": {
        "three": "^0.184.0",
        "zod": "^4.4.3"
    }
}
